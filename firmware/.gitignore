# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories (build-host/: host unit tests,
# build-container/: devcontainer builds, see README;
# build-fwsim-tsan/: test/fwsim/tsan ThreadSanitizer driver)
build-host/
build-fwsim-tsan/
build-container/
**/build/
build/
*.o
*.a
*.out
# Host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
# a linker version script (source), not a map output
!test/fwsim/fwsim.map
# Generated in the build directory
flasher_args.json
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
# General workspace files (various tools)
*.workspace
# Visual Studio solution user options
*.suo
*.sln.docstates

# Machine-specific editor settings (absolute paths to the local ESP-IDF install,
# clangd binary and build directory). Generic .vscode files may be committed.
.vscode/settings.json

# Developer credential provisioning (M1.7): never committed. The secrets JSON and the
# generated NVS image live outside the repository; these patterns are a safety net.
*nvs_sec*.bin
*dev-secrets*.json
*dev_secrets*.json
