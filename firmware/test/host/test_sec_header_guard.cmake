# Host regression test for components/dispenser_domain/sec_header_guard.cmake (M1.10b.3).
# Builds a throw-away tree in the build directory and checks that a violating include is
# reported and allowed files are not. Run: cmake -DWORK=<dir> -P test_sec_header_guard.cmake
get_filename_component(FW "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${FW}/components/dispenser_domain/sec_header_guard.cmake")
if(NOT WORK)
    message(FATAL_ERROR "WORK not set")
endif()
set(failures 0)
file(REMOVE_RECURSE "${WORK}")
file(WRITE "${WORK}/components/x/src/dsp_app.c" "#include \"dsp_app_sec.h\"\n")
file(WRITE "${WORK}/components/x/src/dsp_blesec.c" "  #  include <dsp_app_sec.h>\n")
file(WRITE "${WORK}/components/x/src/dsp_ok.c" "#include \"dsp_app.h\" /* dsp_app_sec.h mentioned only */\n")
dsp_sec_header_guard("${WORK}" bad)
if(NOT bad STREQUAL "")
    message("FAIL allowed files reported: ${bad}")
    math(EXPR failures "${failures} + 1")
endif()
file(WRITE "${WORK}/main/dsp_dispatch.c" "#include \"dsp_app_sec.h\"\n")
file(WRITE "${WORK}/components/y/include/leak.h" "#include <dsp_app_sec.h>\n")
dsp_sec_header_guard("${WORK}" bad)
list(LENGTH bad n)
if(NOT n EQUAL 2)
    message("FAIL expected 2 violations, got: ${bad}")
    math(EXPR failures "${failures} + 1")
endif()
# The real firmware tree is clean.
dsp_sec_header_guard("${FW}" real)
if(NOT real STREQUAL "")
    message("FAIL firmware tree: ${real}")
    math(EXPR failures "${failures} + 1")
endif()
file(REMOVE_RECURSE "${WORK}")
if(failures GREATER 0)
    message(FATAL_ERROR "sec header guard: ${failures} failure(s)")
endif()
message("sec header guard: 3 checks, 0 failed")
