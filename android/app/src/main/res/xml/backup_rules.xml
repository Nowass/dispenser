<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older (API <= 30): allowBackup="false" disables Auto Backup and adb backup.
    Every domain is additionally excluded so no app data is ever included.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
