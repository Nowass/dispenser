// Dispenser V2 notification backend (M1.6a). Targets the EXISTING Worker and D1 database.
// No secrets in this file: DEVICE_API_TOKEN is a Worker secret (production) or comes from
// the ignored .dev.vars file (local development).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispenser-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // No per-version preview URLs: the workers.dev URL is the only entry point.
  "preview_urls": false,
  // Workers Logs (the Worker logs one JSON line per request, never credentials or payloads).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dispenser-notifications",
      // The existing production database (`wrangler d1 list`); an ID, not a secret.
      "database_id": "245fe0d1-4f8c-45c3-b21b-89e00c26be75",
      "migrations_dir": "migrations",
    },
  ],
}
