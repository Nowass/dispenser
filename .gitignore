# Release artifacts are attached to GitHub Releases, never committed
*.apk
*.aab
*.apks
/dist/

# Signing material must never be committed (see docs/RELEASING.md)
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Private configuration backups exported from the app (user data)
dispenser-zaloha-*.json

# RNG-gate captures (firmware/HARDWARE_ACCEPTANCE.md 8a.1): device evidence, kept outside Git
/rng-out/

# OS / editor noise
.DS_Store
Thumbs.db

# Machine-specific editor settings (e.g. absolute path of the local ESP-IDF setup)
/.vscode/settings.json
